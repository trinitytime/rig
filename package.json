{
  "name": "rig-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Rig: an empty JS plugin host (kernel + backend/frontend plugins)",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "type": "module"
}
