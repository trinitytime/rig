{
  "name": "rig-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Rig: an empty JS plugin host (kernel + backend/frontend plugins)",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "rm -rf dist",
    "dev": "tsc -b -w & node --watch dist/core/main.js",
    "start": "node dist/core/main.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "type": "module"
}
