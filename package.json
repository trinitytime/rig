{
  "name": "rig-works",
  "version": "0.1.0",
  "description": "Rig: an empty JS plugin host (kernel + backend/frontend plugins)",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "bun run --filter './packages/*' build",
    "typecheck": "bun run --filter './packages/*' typecheck",
    "test": "bun test",
    "bundle": "npm run bundle --workspaces --if-present",
    "clean": "rm -rf dist",
    "dev": "npm run dev -w @rig-works/core",
    "start": "node packages/launcher/launcher.mjs",
    "outdated": "find . -type f -name 'package.json' -not -path './.git/*' -not -path '*/node_modules/*' -execdir ncu --upgrade \\;"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/bun": "latest",
    "npm-check-updates": "^23.1.1",
    "@types/node": "^26.6.11",
    "bun": "^1.4.5",
    "es-toolkit": "^1.53.2",
    "find-up": "^8.0.0",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "tsdown": "^0.23.7",
    "typescript": "next"
  }
}
