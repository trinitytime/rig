{
  "name": "rig-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Rig: an empty JS plugin host (kernel + backend/frontend plugins)",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "bun test",
    "bundle": "bun build packages/core/src/main.ts --target bun --outfile dist/rig.js",
    "clean": "rm -rf dist",
    "dev": "tsc -b -w & node --watch dist/core/main.js",
    "start": "node packages/launcher/launcher.mjs"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24.19.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2"
  },
  "type": "module"
}