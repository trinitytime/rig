{
  "name": "rig-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Rig: an empty JS plugin host (kernel + backend/frontend plugins)",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -b",
    "build:type": "npm run build:type --workspaces --if-present && node packages/core/scripts/types-package.mjs",
    "typecheck": "npm run build:type && tsc -b && tsc -p tsconfig.plugins.json",
    "test": "bun test",
    "bundle": "npm run bundle --workspaces --if-present",
    "clean": "rm -rf dist",
    "dev": "npm run dev -w @rig-works/core",
    "start": "node packages/launcher/launcher.mjs"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24.19.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^7.0.2"
  },
  "type": "module"
}
