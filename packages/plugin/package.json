{
  "name": "@rig-works/plugin",
  "version": "0.0.0",
  "description": "Rig kernel: plugin lifecycle, RPC/event bus, service registry, localhost server",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "@org/source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "dev": "bun --no-install --watch run src/main.ts",
    "build": "tsdown src/index.ts --dts && write-publish-package",
    "build:type": "tsc --ignoreConfig src/types.ts --declaration --emitDeclarationOnly --outDir ../../dist/types/core --target ES2023 --module NodeNext --skipLibCheck --rewriteRelativeImportExtensions",
    "build:bundle": "bun run scripts/bundle-package.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "find-up": "^8.0.0",
    "hono": "^4.13.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@rig-works/build-tools": "workspace:*",
    "bun": "^1.4.4"
  },
  "engines": {
    "node": ">=22.18"
  },
  "rig": {
    "id": "plugin",
    "displayName": "Plugin",
    "entry": "./dist/index.mjs",
    "requires": []
  }
}
