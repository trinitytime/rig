{
  "name": "@rig-works/plugin",
  "version": "0.0.0",
  "description": "Rig kernel: plugin lifecycle, RPC/event bus, service registry, localhost server",
  "type": "module",
  "private": true,
  "exports": "./src/index.ts",
  "scripts": {
    "dev": "bun --no-install --watch run src/main.ts",
    "build": "tsdown src/index.ts --dts && write-publish-package",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.11",
    "find-up": "^8.0.0",
    "hono": "^4.13.22",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@rig-works/build-tools": "workspace:*"
  },
  "engines": {
    "node": ">=22.18"
  },
  "rig": {
    "id": "plugin",
    "displayName": "Plugin",
    "entry": "./src/index.ts",
    "requires": []
  }
}
