{
  "name": "@rig-works/systray",
  "version": "0.0.0",
  "description": "Rig plugin: system tray menu built from the shared \"tray\" space (systray)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "exports": "./src/index.ts",
   "scripts": {
    "build": "tsdown src/index.ts --dts && write-publish-package && copy-publish-files",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "systray2": "^2.1.4",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@rig-works/plugin": "workspace:*"
  },
  "devDependencies": {
    "@rig-works/build-tools": "workspace:*"
  },
  "files": ["assets"],
  "rig": {
    "id": "systray",
    "displayName": "Systray",
    "entry": "./src/index.ts",
    "requires": []
  }
}
