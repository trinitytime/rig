{
  "name": "@rig-works/dashboard",
  "version": "0.0.0",
  "description": "Rig plugin: renders declarative plugin UI pages from the shared \"ui\" space (dashboard)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsdown src/index.ts --dts && write-publish-package && copy-publish-files",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "exports": "./src/index.ts",
  "files": [
    "src/rig-ui.css",
    "src/client.js"
  ],
  "dependencies": {
    "hono": "^4.13.22",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@rig-works/plugin": "workspace:*"
  },
  "devDependencies": {
    "@rig-works/build-tools": "workspace:*"
  },
  "rig": {
    "id": "dashboard",
    "displayName": "Dashboard",
    "entry": "src/index.js",
    "requires": []
  }
}
