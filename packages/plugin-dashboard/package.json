{
  "name": "@rig/plugin-dashboard",
  "version": "0.0.0",
  "description": "Rig plugin: renders declarative plugin UI pages from the shared \"ui\" space (dashboard)",
  "type": "module",
  "scripts": {
    "build:type": "tsc --ignoreConfig src/types.ts --declaration --emitDeclarationOnly --outDir ../../dist/types/dashboard --target ES2023 --module NodeNext --skipLibCheck --rewriteRelativeImportExtensions"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "hono": "^4.13.17",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@rig/core": "*"
  },
  "devDependencies": {
    "@rig/core": "*"
  },
  "rig": {
    "id": "dashboard",
    "displayName": "Dashboard",
    "entry": "src/index.ts",
    "requires": []
  }
}
